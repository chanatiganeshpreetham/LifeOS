// ============================================================
// LifeOS Phase 1 — Database Schema
// Format: DBML (dbdiagram.io compatible)
// Generated: April 2025
// ============================================================

// ─────────────────────────────────────────
// GROUP: Authentication & User Management
// ─────────────────────────────────────────

Table users {
  id             uuid        [pk, default: `gen_random_uuid()`, note: "Primary key"]
  email          varchar(255) [unique, not null, note: "Login email, lowercase normalised"]
  hashed_password varchar(255) [not null, note: "bcrypt cost 12"]
  full_name      varchar(100) [not null]
  avatar_url     text        [null]
  timezone       varchar(60)  [not null, default: "Asia/Kolkata", note: "IANA timezone string"]
  daily_calorie_target int   [not null, default: 2000]
  sleep_goal_hours     float [not null, default: 8.0]
  water_goal_litres    float [not null, default: 2.0]
  is_active      boolean     [not null, default: true]
  is_verified    boolean     [not null, default: false, note: "Email verified flag"]
  deleted_at     timestamp   [null, note: "Soft delete; queries filter WHERE deleted_at IS NULL"]
  created_at     timestamp   [not null, default: `now()`]
  updated_at     timestamp   [not null, default: `now()`]

  indexes {
    email [unique]
  }

  Note: "Core user record. Every other table references this via user_id."
}

Table refresh_tokens {
  id           uuid      [pk, default: `gen_random_uuid()`]
  user_id      uuid      [not null, ref: > users.id]
  token_hash   varchar(255) [unique, not null, note: "SHA-256 of the opaque token sent in HttpOnly cookie"]
  expires_at   timestamp [not null]
  is_revoked   boolean   [not null, default: false]
  device_hint  varchar(100) [null, note: "Browser user-agent snippet for display"]
  created_at   timestamp [not null, default: `now()`]

  indexes {
    user_id
    token_hash [unique]
  }

  Note: "7-day rolling sessions. Revoked on logout or password change."
}

Table otp_codes {
  id         uuid        [pk, default: `gen_random_uuid()`]
  user_id    uuid        [not null, ref: > users.id]
  code_hash  varchar(255) [not null, note: "bcrypt hash of 6-digit OTP"]
  purpose    varchar(30)  [not null, note: "Enum: password_reset | email_verify"]
  expires_at timestamp   [not null, note: "now() + 10 minutes"]
  is_used    boolean     [not null, default: false]
  created_at timestamp   [not null, default: `now()`]

  indexes {
    (user_id, purpose, is_used)
  }

  Note: "Single-use OTPs. Celery cleans up expired rows nightly."
}

// ─────────────────────────────────────────
// GROUP: Tasks & Productivity
// ─────────────────────────────────────────

Table tasks {
  id                uuid        [pk, default: `gen_random_uuid()`]
  user_id           uuid        [not null, ref: > users.id]
  recurring_rule_id uuid        [null, ref: > recurring_task_rules.id, note: "Set when auto-generated by a rule"]
  title             varchar(500) [not null]
  notes             text        [null]
  priority          varchar(10)  [not null, default: "medium", note: "Enum: high | medium | low"]
  due_at            timestamp   [null]
  is_completed      boolean     [not null, default: false]
  completed_at      timestamp   [null]
  sort_order        int         [not null, default: 0, note: "Manual drag-and-drop order (Phase 2)"]
  deleted_at        timestamp   [null]
  search_vector     tsvector    [null, note: "Auto-updated by Postgres trigger on title + notes"]
  created_at        timestamp   [not null, default: `now()`]
  updated_at        timestamp   [not null, default: `now()`]

  indexes {
    (user_id, due_at) [note: "Dashboard and filter queries"]
    (user_id, is_completed)
    search_vector [type: gin, note: "Full-text search"]
    (user_id, deleted_at)
  }

  Note: "Core task record. Soft-deleted. Full-text search via GIN index on tsvector."
}

Table recurring_task_rules {
  id            uuid        [pk, default: `gen_random_uuid()`]
  user_id       uuid        [not null, ref: > users.id]
  title         varchar(500) [not null]
  priority      varchar(10)  [not null, default: "medium"]
  notes         text        [null]
  frequency     varchar(20)  [not null, note: "Enum: daily | weekly | monthly | custom"]
  weekdays      varchar[]   [null, note: "e.g. [mon, wed, fri] for custom weekly"]
  day_of_month  int         [null, note: "Used when frequency = monthly"]
  next_due_at   timestamp   [not null]
  is_active     boolean     [not null, default: true]
  created_at    timestamp   [not null, default: `now()`]
  updated_at    timestamp   [not null, default: `now()`]

  indexes {
    (user_id, is_active, next_due_at) [note: "Celery Beat queries this every night"]
  }

  Note: "Template for recurring tasks. Celery generates a tasks row from this each cycle."
}

// ─────────────────────────────────────────
// GROUP: Reminders & Notifications
// ─────────────────────────────────────────

Table reminders {
  id              uuid        [pk, default: `gen_random_uuid()`]
  user_id         uuid        [not null, ref: > users.id]
  title           varchar(300) [not null]
  notes           text        [null]
  remind_at       timestamp   [not null]
  is_recurring    boolean     [not null, default: false]
  frequency       varchar(20)  [null, note: "Enum: daily | weekly | monthly | custom"]
  weekdays        varchar[]   [null]
  snooze_minutes  int         [null, note: "Re-enqueue Celery task by this many minutes"]
  is_active       boolean     [not null, default: true]
  is_acknowledged boolean     [not null, default: false]
  deleted_at      timestamp   [null]
  created_at      timestamp   [not null, default: `now()`]
  updated_at      timestamp   [not null, default: `now()`]

  indexes {
    (user_id, remind_at, is_active, is_acknowledged) [note: "Celery checks this every minute"]
  }

  Note: "Independent of tasks. Celery poll queries remind_at <= now() AND is_acknowledged = false."
}

Table push_subscriptions {
  id           uuid        [pk, default: `gen_random_uuid()`]
  user_id      uuid        [not null, ref: > users.id]
  endpoint     text        [unique, not null, note: "Browser push endpoint URL (FCM / APNs)"]
  p256dh_key   text        [not null, note: "VAPID public key for this subscription"]
  auth_key     text        [not null, note: "Auth secret for encrypted push"]
  device_label varchar(100) [null, note: "e.g. Chrome on Android"]
  is_active    boolean     [not null, default: true]
  created_at   timestamp   [not null, default: `now()`]

  indexes {
    user_id
    endpoint [unique]
  }

  Note: "Stores Web Push API subscriptions. pywebpush uses endpoint + keys to deliver."
}

Table notification_log {
  id              uuid        [pk, default: `gen_random_uuid()`]
  user_id         uuid        [not null, ref: > users.id]
  reminder_id     uuid        [null, ref: > reminders.id]
  type            varchar(40)  [not null, note: "Enum: push | in_app | email | budget_alert | cc_due | subscription_due"]
  status          varchar(20)  [not null, note: "Enum: sent | failed | read"]
  payload_summary text        [null, note: "Short description stored for in-app bell display"]
  sent_at         timestamp   [not null, default: `now()`]
  read_at         timestamp   [null]
  created_at      timestamp   [not null, default: `now()`]

  indexes {
    (user_id, status, sent_at)
  }

  Note: "All push + in-app notifications logged here. Frontend polls for unread count."
}

// ─────────────────────────────────────────
// GROUP: Finance — Expenses & Budgets
// ─────────────────────────────────────────

Table expense_categories {
  id          uuid        [pk, default: `gen_random_uuid()`]
  user_id     uuid        [null, ref: > users.id, note: "NULL for system default categories shared across all users"]
  name        varchar(80)  [not null]
  icon        varchar(50)  [null, note: "Icon identifier (e.g. emoji or icon key)"]
  colour_hex  varchar(7)   [not null, default: "#6B7280"]
  is_system   boolean     [not null, default: false, note: "System categories cannot be deleted"]
  created_at  timestamp   [not null, default: `now()`]

  indexes {
    user_id
  }

  Note: "12 system categories seeded at startup. Users can add custom ones. user_id=NULL = global system category."
}

Table expenses {
  id             uuid        [pk, default: `gen_random_uuid()`]
  user_id        uuid        [not null, ref: > users.id]
  category_id    uuid        [not null, ref: > expense_categories.id]
  credit_card_id uuid        [null, ref: > credit_cards.id, note: "Set if expense paid via a tracked card"]
  amount         numeric(12,2) [not null, note: "Always stored in INR"]
  currency       varchar(3)  [not null, default: "INR"]
  merchant       varchar(200) [null]
  notes          text        [null]
  expense_date   date        [not null, note: "User-selected date, not created_at"]
  source         varchar(20)  [not null, default: "manual", note: "Enum: manual | sms_parse (Phase 2)"]
  deleted_at     timestamp   [null]
  created_at     timestamp   [not null, default: `now()`]
  updated_at     timestamp   [not null, default: `now()`]

  indexes {
    (user_id, expense_date)
    (user_id, category_id)
    (user_id, credit_card_id)
  }

  Note: "All expense amounts in INR numeric(12,2). Never float. Soft-deleted."
}

Table income_entries {
  id          uuid        [pk, default: `gen_random_uuid()`]
  user_id     uuid        [not null, ref: > users.id]
  amount      numeric(12,2) [not null]
  source      varchar(100) [not null, note: "e.g. Salary, Freelance, Rental"]
  notes       text        [null]
  income_date date        [not null]
  created_at  timestamp   [not null, default: `now()`]
  updated_at  timestamp   [not null, default: `now()`]

  indexes {
    (user_id, income_date)
  }

  Note: "Separate from expenses. Net balance = SUM(income) - SUM(expenses) per month."
}

Table budgets {
  id               uuid        [pk, default: `gen_random_uuid()`]
  user_id          uuid        [not null, ref: > users.id]
  category_id      uuid        [not null, ref: > expense_categories.id]
  monthly_limit    numeric(12,2) [not null]
  budget_month     int         [not null, note: "1-12"]
  budget_year      int         [not null]
  alert_80_sent    boolean     [not null, default: false]
  alert_100_sent   boolean     [not null, default: false]
  created_at       timestamp   [not null, default: `now()`]
  updated_at       timestamp   [not null, default: `now()`]

  indexes {
    (user_id, budget_year, budget_month)
    (user_id, category_id, budget_year, budget_month) [unique]
  }

  Note: "One budget row per user per category per month. Alert flags reset at month rollover."
}

Table credit_cards {
  id               uuid        [pk, default: `gen_random_uuid()`]
  user_id          uuid        [not null, ref: > users.id]
  card_name        varchar(100) [not null, note: "e.g. HDFC Regalia, Axis Magnus"]
  bank_name        varchar(80)  [not null]
  last_four_digits varchar(4)  [null]
  credit_limit     numeric(12,2) [not null]
  billing_date     int         [not null, note: "Day of month statement generates (1-31)"]
  due_date         int         [not null, note: "Day of month payment due (1-31)"]
  current_balance  numeric(12,2) [not null, default: 0, note: "Manually updated or derived from expenses"]
  is_active        boolean     [not null, default: true]
  alert_3day_sent  boolean     [not null, default: false, note: "Reset each billing cycle"]
  alert_0day_sent  boolean     [not null, default: false]
  deleted_at       timestamp   [null]
  created_at       timestamp   [not null, default: `now()`]
  updated_at       timestamp   [not null, default: `now()`]

  indexes {
    user_id
  }

  Note: "Supports HDFC, Axis, Amex, SBI, ICICI, Kotak. alert flags reset monthly by Celery."
}

// ─────────────────────────────────────────
// GROUP: Health — Mood, Sleep, Habits, Water
// ─────────────────────────────────────────

Table mood_logs {
  id          uuid        [pk, default: `gen_random_uuid()`]
  user_id     uuid        [not null, ref: > users.id]
  mood_score  int         [not null, note: "1=very bad 2=bad 3=ok 4=good 5=great"]
  notes       varchar(300) [null, note: "Optional context, max 300 chars"]
  logged_at   timestamp   [not null, default: `now()`]
  log_date    date        [not null, note: "One entry per day enforced at service layer"]
  created_at  timestamp   [not null, default: `now()`]

  indexes {
    (user_id, log_date) [unique, note: "Enforces one check-in per day"]
    (user_id, logged_at)
  }

  Note: "1-5 emoji scale. Service layer upserts on log_date to allow editing today's entry."
}

Table sleep_logs {
  id             uuid        [pk, default: `gen_random_uuid()`]
  user_id        uuid        [not null, ref: > users.id]
  bedtime        timestamp   [not null]
  wake_time      timestamp   [not null]
  duration_hours float       [not null, note: "Computed: (wake_time - bedtime) in hours"]
  quality_rating int         [not null, note: "1-5 scale"]
  notes          text        [null]
  sleep_date     date        [not null, note: "The calendar date this sleep is attributed to (wake date)"]
  created_at     timestamp   [not null, default: `now()`]
  updated_at     timestamp   [not null, default: `now()`]

  indexes {
    (user_id, sleep_date)
  }

  Note: "duration_hours computed server-side. sleep_date = date(wake_time) for attribution."
}

Table habits {
  id              uuid        [pk, default: `gen_random_uuid()`]
  user_id         uuid        [not null, ref: > users.id]
  name            varchar(150) [not null]
  colour_hex      varchar(7)  [not null, default: "#6366F1"]
  frequency       varchar(20)  [not null, note: "Enum: daily | specific_days | weekly_count"]
  target_weekdays varchar[]   [null, note: "e.g. [mon,tue,thu] — only used when frequency=specific_days"]
  current_streak  int         [not null, default: 0]
  longest_streak  int         [not null, default: 0]
  is_active       boolean     [not null, default: true]
  deleted_at      timestamp   [null]
  created_at      timestamp   [not null, default: `now()`]
  updated_at      timestamp   [not null, default: `now()`]

  indexes {
    (user_id, is_active)
  }

  Note: "Streak logic runs in service layer on each completion. longest_streak never decrements."
}

Table habit_completions {
  id              uuid        [pk, default: `gen_random_uuid()`]
  habit_id        uuid        [not null, ref: > habits.id]
  user_id         uuid        [not null, ref: > users.id]
  completion_date date        [not null]
  created_at      timestamp   [not null, default: `now()`]

  indexes {
    (habit_id, completion_date) [unique, note: "One completion per habit per day"]
    (user_id, completion_date)
  }

  Note: "Immutable once inserted. Heatmap queries aggregate by date range."
}

Table water_logs {
  id         uuid      [pk, default: `gen_random_uuid()`]
  user_id    uuid      [not null, ref: > users.id]
  amount_ml  int       [not null, default: 250, note: "Tap-to-add = 250ml default"]
  logged_at  timestamp [not null, default: `now()`]
  log_date   date      [not null, note: "Derived from logged_at at insert time"]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, log_date)
  }

  Note: "Multiple rows per day. Dashboard sums amount_ml WHERE log_date = today."
}

// ─────────────────────────────────────────
// GROUP: Notes & Knowledge Base
// ─────────────────────────────────────────

Table notes {
  id            uuid        [pk, default: `gen_random_uuid()`]
  user_id       uuid        [not null, ref: > users.id]
  title         varchar(300) [not null]
  body          text        [null]
  is_pinned     boolean     [not null, default: false]
  search_vector tsvector    [null, note: "Auto-updated trigger on title + body"]
  deleted_at    timestamp   [null]
  created_at    timestamp   [not null, default: `now()`]
  updated_at    timestamp   [not null, default: `now()`]

  indexes {
    (user_id, updated_at)
    (user_id, is_pinned)
    search_vector [type: gin]
  }

  Note: "Auto-saved with 1.5s debounce on frontend. Soft-deleted. Full-text GIN index."
}

Table note_tags {
  id         uuid        [pk, default: `gen_random_uuid()`]
  user_id    uuid        [not null, ref: > users.id]
  name       varchar(80)  [not null]
  created_at timestamp   [not null, default: `now()`]

  indexes {
    (user_id, name) [unique]
  }

  Note: "Tag names unique per user. Autocomplete queries this table."
}

Table notes_tags {
  note_id uuid [not null, ref: > notes.id]
  tag_id  uuid [not null, ref: > note_tags.id]

  indexes {
    (note_id, tag_id) [pk]
    tag_id
  }

  Note: "Junction table. Cascade delete when note or tag is hard-deleted."
}

// ─────────────────────────────────────────
// GROUP: Subscriptions
// ─────────────────────────────────────────

Table subscriptions {
  id                uuid        [pk, default: `gen_random_uuid()`]
  user_id           uuid        [not null, ref: > users.id]
  name              varchar(150) [not null, note: "e.g. Netflix, Spotify, GitHub Pro"]
  amount            numeric(12,2) [not null, note: "Cost per billing cycle in INR"]
  billing_cycle     varchar(20)  [not null, note: "Enum: monthly | quarterly | annual"]
  next_billing_date date        [not null]
  website_url       text        [null]
  notes             text        [null]
  alert_3day_sent   boolean     [not null, default: false]
  is_active         boolean     [not null, default: true]
  deleted_at        timestamp   [null]
  created_at        timestamp   [not null, default: `now()`]
  updated_at        timestamp   [not null, default: `now()`]

  indexes {
    (user_id, next_billing_date)
    (user_id, is_active)
  }

  Note: "Celery checks next_billing_date - today <= 3. Monthly normalised cost = amount / cycle_months."
}

// ─────────────────────────────────────────
// GROUP: Relationship CRM (Phase 1 lite)
// ─────────────────────────────────────────

Table contacts {
  id                      uuid        [pk, default: `gen_random_uuid()`]
  user_id                 uuid        [not null, ref: > users.id]
  full_name               varchar(150) [not null]
  relationship_type       varchar(20)  [not null, note: "Enum: family | friend | mentor | colleague | other"]
  birthday                date        [null]
  checkin_frequency_days  int         [null, note: "e.g. 7 = contact every week"]
  last_contact_date       date        [null]
  notes                   text        [null, note: "Free text about the relationship"]
  birthday_alert_sent_year int        [null, note: "Year last birthday alert was sent to avoid duplicates"]
  deleted_at              timestamp   [null]
  created_at              timestamp   [not null, default: `now()`]
  updated_at              timestamp   [not null, default: `now()`]

  indexes {
    user_id
    (user_id, birthday)
  }

  Note: "Lightweight personal CRM. Overdue check-in computed: today - last_contact_date > checkin_frequency_days."
}

// ─────────────────────────────────────────
// PHASE 2 EXTENSION STUBS
// (Tables designed now, populated in Phase 2)
// ─────────────────────────────────────────

Table food_logs {
  id          uuid        [pk, default: `gen_random_uuid()`]
  user_id     uuid        [not null, ref: > users.id]
  meal_name   varchar(200) [not null]
  meal_type   varchar(20)  [not null, note: "Enum: breakfast | lunch | dinner | snack"]
  calories    int         [not null]
  protein_g   float       [null]
  carbs_g     float       [null]
  fat_g       float       [null]
  logged_at   timestamp   [not null, default: `now()`]
  log_date    date        [not null]
  created_at  timestamp   [not null, default: `now()`]

  indexes {
    (user_id, log_date)
  }

  Note: "Phase 2 module. Schema defined in Phase 1 migration for forward compatibility."
}

Table workout_logs {
  id             uuid        [pk, default: `gen_random_uuid()`]
  user_id        uuid        [not null, ref: > users.id]
  workout_type   varchar(30)  [not null, note: "Enum: cardio | strength | yoga | sports | flexibility | other"]
  duration_min   int         [not null]
  calories_burned int        [null]
  notes          text        [null]
  logged_at      timestamp   [not null, default: `now()`]
  log_date       date        [not null]
  created_at     timestamp   [not null, default: `now()`]

  indexes {
    (user_id, log_date)
  }

  Note: "Phase 2 module. Schema stub in Phase 1 migration."
}

Table ai_digests {
  id           uuid        [pk, default: `gen_random_uuid()`]
  user_id      uuid        [not null, ref: > users.id]
  digest_date  date        [not null]
  content      text        [not null, note: "Natural language insight from Claude API"]
  tokens_used  int         [null]
  model        varchar(60)  [null]
  created_at   timestamp   [not null, default: `now()`]

  indexes {
    (user_id, digest_date) [unique]
  }

  Note: "Phase 2. Cached AI digest generated daily at 07:00 by Celery. One per user per day."
}
