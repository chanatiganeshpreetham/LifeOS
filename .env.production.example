ENVIRONMENT=production
# For PostgreSQL on this Ubuntu host, use host.docker.internal in the URL.
# Example: postgresql://lifeos:URL_ENCODED_PASSWORD@host.docker.internal:5432/lifeos
DATABASE_URL=postgresql://lifeos:CHANGE_ME@host.docker.internal:5432/lifeos
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FRONTEND_URL=https://lifeos.example.com

# Auth0 application and API values. These are also embedded in the frontend image.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_AUDIENCE=https://lifeos-api

# Production requires an SMTP server. Use your provider's settings.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_FROM=noreply@example.com
MAIL_STARTTLS=true
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password

# Optional browser push; set all three together.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_EMAIL=you@example.com

VITE_API_BASE_URL=/api/v1
